@page "/projects"
@rendermode InteractiveServer

@using ProjectHub.Application.Projects

@inject IProjectService ProjectService

@attribute [Authorize]

<!-- Discussion Point: What this Does -->
<PageTitle>Projects</PageTitle>

<h1>Projects</h1>

@if (_projects == null)
{
    <p>Loading...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Project</th>
                <th>Status</th>
                <th>Open Items</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var project in _projects)
            {
                <tr>
                    <td>
                        <a href="@($"/projects/{project.ProjectId}")">
                            @project.Name
                        </a>
                    </td>
                    <td>@project.Status</td>
                    <td>
                        @project.OpenWorkItemCount
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code
{
    private IReadOnlyList<ProjectListItem>? _projects;

    protected override async Task OnInitializedAsync()
    {
		_projects = await ProjectService.GetProjectsAsync();
    }
}