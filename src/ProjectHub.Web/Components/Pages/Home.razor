@page "/"

@using ProjectHub.Application.Identity

@inject ICurrentUser CurrentUser
@inject ILogger<Home> Logger

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<h2>Current User Status</h2>

@if (_currentUserId.HasValue)
{
	<p>Current User ID: @_currentUserId</p>
}
else
{
	<p>No user is currently logged in.</p>
}

@code{
	private Guid? _currentUserId;

	protected override async Task OnInitializedAsync()
	{
		_currentUserId = await CurrentUser.GetUserIdAsync();
		// Non-Template
        Logger.LogInformation($"Current User ID: {_currentUserId}");

		// Template
        Logger.LogInformation("Current User ID: {UserId}", _currentUserId);
	}
}